GLM_API_KEY=your-zhipu-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5-flash
# disabled = fast chat; enabled = slower CoT
GLM_THINKING=disabled
GLM_TRUST_ENV=false
GLM_MAX_TOKENS=8192
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=data/me.db

# BYOK 功能：用于加密用户自带的模型 API Key，32字节 base64url，生产环境务必自行生成覆盖
# 生成方式：python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BYOK_ENCRYPTION_KEY=

# 邮箱验证码发送（留空 = 开发模式，验证码会打印在后端日志里，不会真实发信）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=ME.xyz
